<?xml version="1.0" encoding="utf-8"?>
<extension type="module" client="site" method="upgrade">
    <name>MOD_NUMISTR_ILGILI</name>
    <author>NumisTR</author>
    <creationDate>2026-10-15</creationDate>
    <copyright>Copyright (C) 2026 NumisTR. All rights reserved.</copyright>
    <license>GNU General Public License version 2 or later</license>
    <authorEmail>info@numistr.org</authorEmail>
    <authorUrl>https://www.numistr.org</authorUrl>
    <version>1.3.0</version>
    <description>MOD_NUMISTR_ILGILI_XML_DESCRIPTION</description>

    <files>
        <filename module="mod_numistr_ilgili">mod_numistr_ilgili.php</filename>
        <filename>helper.php</filename>
        <folder>tmpl</folder>
        <folder>data</folder>
        <folder>language</folder>
    </files>

    <media destination="mod_numistr_ilgili" folder="media">
        <folder>css</folder>
        <folder>js</folder>
    </media>

    <languages>
        <language tag="en-GB">language/en-GB/mod_numistr_ilgili.ini</language>
        <language tag="en-GB">language/en-GB/mod_numistr_ilgili.sys.ini</language>
        <language tag="tr-TR">language/tr-TR/mod_numistr_ilgili.ini</language>
        <language tag="tr-TR">language/tr-TR/mod_numistr_ilgili.sys.ini</language>
    </languages>

    <config>
        <fields name="params">
            <fieldset name="basic">
                <field name="limit" type="number" label="MOD_NUMISTR_ILGILI_LIMIT_LABEL" default="8" min="1" max="24" filter="integer"/>
                <field name="bolum" type="list" label="MOD_NUMISTR_ILGILI_BOLUM_LABEL" description="MOD_NUMISTR_ILGILI_BOLUM_DESC" default="alt" filter="cmd">
                    <option value="alt">MOD_NUMISTR_ILGILI_BOLUM_ALT</option>
                    <option value="ust">MOD_NUMISTR_ILGILI_BOLUM_UST</option>
                </field>
                <field name="blog_kategorileri" type="text" label="MOD_NUMISTR_ILGILI_BLOG_LABEL" description="MOD_NUMISTR_ILGILI_BLOG_DESC" default="35,36,37,38,39,40,107,108,109,110,111,112" filter="string"/>
                <field name="seri_limit" type="number" label="MOD_NUMISTR_ILGILI_SERI_LIMIT_LABEL" default="4" min="1" max="12" filter="integer"/>
                <field name="yazi_limit" type="number" label="MOD_NUMISTR_ILGILI_YAZI_LIMIT_LABEL" default="6" min="1" max="12" filter="integer"/>
                <field name="cta" type="radio" label="MOD_NUMISTR_ILGILI_CTA_LABEL" default="1" layout="joomla.form.field.radio.switcher" filter="integer">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field name="okuma_hizi" type="number" label="MOD_NUMISTR_ILGILI_OKUMA_HIZI_LABEL" default="200" min="100" max="400" filter="integer"/>
            </fieldset>
            <fieldset name="advanced">
                <field name="layout" type="modulelayout" label="JFIELD_ALT_LAYOUT_LABEL" class="form-select" validate="moduleLayout"/>
                <field name="moduleclass_sfx" type="textarea" label="COM_MODULES_FIELD_MODULECLASS_SFX_LABEL" rows="3" validate="CssIdentifier"/>
                <field name="cache" type="list" label="COM_MODULES_FIELD_CACHING_LABEL" default="1" filter="integer" validate="options">
                    <option value="1">JGLOBAL_USE_GLOBAL</option>
                    <option value="0">COM_MODULES_FIELD_VALUE_NOCACHING</option>
                </field>
                <field name="cache_time" type="number" label="COM_MODULES_FIELD_CACHE_TIME_LABEL" default="900" filter="integer"/>
                <field name="cachemode" type="hidden" default="safeuri"/>
            </fieldset>
        </fields>
    </config>
</extension>
