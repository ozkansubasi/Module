<?xml version="1.0" encoding="utf-8"?>
<extension type="module" client="site" method="upgrade">
    <name>MOD_NUMISTR_CHAT</name>
    <author>NumisTR</author>
    <creationDate>August 2026</creationDate>
    <copyright>Copyright (C) 2025-2026 NumisTR. All rights reserved.</copyright>
    <license>GNU General Public License version 2 or later</license>
    <authorEmail>info@numistr.org</authorEmail>
    <authorUrl>https://www.numistr.org</authorUrl>
    <version>2.2.0</version>
    <description>MOD_NUMISTR_CHAT_XML_DESCRIPTION</description>

    <files>
        <filename module="mod_numistr_chat">mod_numistr_chat.php</filename>
        <folder>tmpl</folder>
        <folder>language</folder>
    </files>

    <media destination="mod_numistr_chat" folder="media">
        <folder>js</folder>
        <filename>index.html</filename>
    </media>

    <languages>
        <language tag="en-GB">language/en-GB/mod_numistr_chat.ini</language>
        <language tag="en-GB">language/en-GB/mod_numistr_chat.sys.ini</language>
        <language tag="tr-TR">language/tr-TR/mod_numistr_chat.ini</language>
        <language tag="tr-TR">language/tr-TR/mod_numistr_chat.sys.ini</language>
    </languages>

    <config>
        <fields name="params">
            <fieldset name="basic">
                <field
                    name="recognize_enabled"
                    type="radio"
                    layout="joomla.form.field.radio.switcher"
                    label="MOD_NUMISTR_CHAT_RECOGNIZE_LABEL"
                    description="MOD_NUMISTR_CHAT_RECOGNIZE_DESC"
                    default="1"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>

                <field
                    name="api_base"
                    type="text"
                    label="MOD_NUMISTR_CHAT_API_BASE_LABEL"
                    description="MOD_NUMISTR_CHAT_API_BASE_DESC"
                    default="/index.php?option=com_ajax&amp;group=webservices&amp;plugin=numistr&amp;format=json"
                    required="true"
                />

                <field
                    name="widget_position"
                    type="list"
                    label="MOD_NUMISTR_CHAT_POSITION_LABEL"
                    description="MOD_NUMISTR_CHAT_POSITION_DESC"
                    default="bottom-right"
                >
                    <option value="bottom-right">MOD_NUMISTR_CHAT_POSITION_BOTTOM_RIGHT</option>
                    <option value="bottom-left">MOD_NUMISTR_CHAT_POSITION_BOTTOM_LEFT</option>
                </field>

                <field
                    name="primary_color"
                    type="color"
                    label="MOD_NUMISTR_CHAT_COLOR_LABEL"
                    description="MOD_NUMISTR_CHAT_COLOR_DESC"
                    default="#8B4513"
                />

                <field
                    name="secondary_color"
                    type="color"
                    label="MOD_NUMISTR_CHAT_COLOR2_LABEL"
                    description="MOD_NUMISTR_CHAT_COLOR2_DESC"
                    default="#D4AF37"
                />

                <field
                    name="restore_history"
                    type="radio"
                    layout="joomla.form.field.radio.switcher"
                    label="MOD_NUMISTR_CHAT_RESTORE_LABEL"
                    description="MOD_NUMISTR_CHAT_RESTORE_DESC"
                    default="1"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
            </fieldset>

            <fieldset name="advanced">
                <field
                    name="cache"
                    type="list"
                    label="COM_MODULES_FIELD_CACHING_LABEL"
                    description="COM_MODULES_FIELD_CACHING_DESC"
                    default="0"
                >
                    <option value="1">JGLOBAL_USE_GLOBAL</option>
                    <option value="0">COM_MODULES_FIELD_VALUE_NOCACHING</option>
                </field>

                <field
                    name="moduleclass_sfx"
                    type="textarea"
                    label="COM_MODULES_FIELD_MODULECLASS_SFX_LABEL"
                    description="COM_MODULES_FIELD_MODULECLASS_SFX_DESC"
                    rows="3"
                />
            </fieldset>
        </fields>
    </config>
</extension>
